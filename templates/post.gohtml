<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Créer un post | Forum La Tcheam</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
    <header>
        <h1>Création d'un nouveau post</h1>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/AllPost">Forum</a></li>
                {{ if .Username }}
                    <li><a href="/logout">Déconnexion</a></li>
                {{ else }}
                    <li><a href="/login">Connexion</a></li>
                    <li><a href="/registe">Inscription</a></li>
                {{ end }}
            </ul>
        </nav>
        <div class="user-info">
            {{ if .Username }}
                <span>Bonjour, {{ .Username }}</span>
            {{ end }}
        </div>
    </header>

    <main>
        {{ if .Username }}
            {{ if .Error }}
                <div class="error-message">
                    <p>{{ .Error }}</p>
                </div>
            {{ end }}

            <div class="post-form">
                <form action="/posts" method="POST">
                    <div class="form-group">
                        <label for="title">Titre du post :</label>
                        <input type="text" id="title" name="title" required>
                    </div>

                    <div class="form-group">
                        <label for="content">Contenu :</label>
                        <textarea id="content" name="content" rows="10" required></textarea>
                    </div>

                    <button type="submit" class="btn">Summit</button>
                </form>
            </div>
        {{ else }}
            <p class="message">Vous devez être connecté pour créer un post. <a href="/login">Se connecter</a></p>
        {{ end }}
    </main>

    <footer>
        <p>&copy; 2025 La Tcheam. Tous droits réservés.</p>
    </footer>
</body>
</html>