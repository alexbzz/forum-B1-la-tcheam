<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Post.Title }} | Forum La Tcheam</title>
    <link rel="stylesheet" type="text/css" href="../static/css/style.css" />
</head>
<body>
<header>
    <h1>Forum de la Tcheam</h1>
    <nav>
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/AllPost">Forum</a></li>
            <li><a href="/create-post">Create Post</a></li>
            {{ if .Username }}
            {{ else }}
            {{ end }}
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
            <li><span>Bonjour, {{ .Username }}</span></li>
        </ul>
    </nav>
</header>

<main>
    <article class="post-detail">
        <h2>{{ .Post.Title }}</h2>
        <div class="post-meta">
            <span class="author">Par {{ .Post.Author }}</span>
            <span class="date">Le {{ .Post.CreatedAt.Format "02/01/2006 à 15:04" }}</span>
        </div>
        <div class="post-content">
            {{ .Post.Content }}
        </div>

        <div class="reactions">
            <form action="/react" method="POST" style="display: inline">
                <input type="hidden" name="post_id" value="{{ .Post.ID }}">
                <input type="hidden" name="type" value="like">
                <button type="submit">👍 {{ .Post.Likes }}</button>
            </form>
            <form action="/react" method="POST" style="display: inline">
                <input type="hidden" name="post_id" value="{{ .Post.ID }}">
                <input type="hidden" name="type" value="dislike">
                <button type="submit">👎 {{ .Post.Dislikes }}</button>
            </form>
        </div>
        <div class="comments-section">
            {{ if .Username }}
                <form action="/add-comment" method="POST">
                    <input type="hidden" name="post_id" value="{{ .Post.ID }}">
                    <textarea name="content" required></textarea>
                    <button type="submit">Commenter</button>
                </form>
            {{ end }}

            <div class="comments-list">
                {{ if .Comments }}
                    {{ range .Comments }}
                        <div class="comment">
                            <p><strong>{{ .Author }}</strong> - {{ .CreatedAt }}</p>
                            <p>{{ .Content }}</p>
                        </div>
                    {{ end }}
                {{ else }}
                    <p>Aucun commentaire</p>
                {{ end }}
            </div>
        </div>

        <a href="/AllPost" class="btn">Retour aux posts</a>
    </article>
</main>

<footer>
    <p>&copy; 2025 La Tcheam. Tous droits réservés.</p>
</footer>
</body>
</html>