body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(120deg, #1f1c2c, #928dab);
    color: #fff;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 40px 50px;
    border-radius: 15px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
    text-align: center;
    max-width: 400px;
    width: 100%;
    transition: opacity 1s ease;
}

h1 {
    margin-bottom: 25px;
    font-size: 32px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.input-group {
    display: flex;
    flex-direction: column;
    text-align: left;
    position: relative;
    transition: 0.3s ease;
}

.input-group label {
    margin-bottom: 6px;
    font-weight: bold;
    color: #ccc;
    transition: color 0.3s ease;
}

.input-group input {
    padding: 10px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    background-color: #f0f0f0;
    color: #000;
}

.input-group.active label {
    color: #00ffff;
}

/* Submit button with glitch effect inspired style */
button[type="submit"] {
    position: relative;
    display: inline-block;
    padding: 12px 20px;
    width: 100%;
    color: #fff;
    background: linear-gradient(45deg, #6a00ff, #8e2de2);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    overflow: hidden;
    font-weight: 700;
    letter-spacing: 1.2px;
    transition: background 0.3s ease;
    box-shadow: 0 4px 15px rgba(142, 45, 226, 0.6);
}

button[type="submit"]::before,
button[type="submit"]::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(60deg,
            rgba(255, 255, 255, 0.2) 0%,
            rgba(255, 255, 255, 0) 60%);
    transform: rotate(25deg);
    transition: transform 0.5s ease;
    pointer-events: none;
    border-radius: 8px;
}

button[type="submit"]::after {
    top: auto;
    bottom: -50%;
    left: -50%;
    transform: rotate(-25deg);
}

button[type="submit"]:hover {
    background: linear-gradient(45deg, #8e2de2, #6a00ff);
    box-shadow: 0 6px 20px rgba(106, 0, 255, 0.9);
}

button[type="submit"]:hover::before {
    transform: rotate(25deg) translateX(20%);
}

button[type="submit"]:hover::after {
    transform: rotate(-25deg) translateX(-20%);
}


.social-login {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 15px;
}

.social-login img {
    cursor: pointer;
    transition: transform 0.3s ease;
}

.social-login img:hover {
    transform: scale(1.1);
}

p {
    margin-top: 20px;
    font-size: 14px;
}

p a {
    color: #00ffff;
    text-decoration: none;
}

p a:hover {
    text-decoration: underline;
}